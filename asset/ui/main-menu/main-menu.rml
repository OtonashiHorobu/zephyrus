<rml>
<head>
    <title>Zephyrus</title>
    <style>
        body
        {
            display: block;
            width: 100%;
            height: 100%;
            font-family: "DejaVu Sans";
            font-size: 16dp;
            color: #ffffff;
        }

        #panel
        {
            display: block;
            position: absolute;
            left: 40dp;
            top: 40dp;
            width: 380dp;
            height: 120dp;
            padding: 16dp;
            background-color: rgba(16, 20, 28, 224);
            border-width: 2dp;
            border-color: rgba(75, 138, 214, 230);
            border-radius: 8dp;
        }

        h1
        {
            display: block;
            font-size: 24dp;
            color: #8ecbff;
            margin-bottom: 8dp;
        }

        p
        {
            display: block;
        }

        .hint
        {
            display: block;
            margin-top: 6dp;
            font-size: 13dp;
            color: #b8c2cc;
        }
    </style>
</head>
<body>
    <div id="panel">
        <h1>Zephyrus</h1>
        <p>Overlay online.</p>
        <p class="hint">INSERT toggles the overlay.</p>
    </div>
</body>
</rml>
