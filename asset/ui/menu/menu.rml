                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="kb-exp-knife-popup">
                                    <div class="combo-item" id="kb-exp-knife-off">Off</div>
                                    <div class="combo-item" id="kb-exp-knife-always">Always</div>
                                    <div class="combo-item" id="kb-exp-knife-hold">Hold</div>
                                    <div class="combo-item" id="kb-exp-knife-toggle">Toggle</div>
                                    <div class="combo-item" id="kb-exp-knife-unset">Unset</div>
                                </div>
                            </div>
                        </div></div>
                        <div class="row"><span class="label">Trigger</span><div class="ctrl"><div class="btn btn-primary" id="btn-exp-knife">KNIFE</div></div></div>
                        <div class="row"><span class="label">Recycle drop</span><div class="ctrl"><div class="checkbox" id="cb-exp-knife-recycle"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Spacing</span><div class="ctrl"><span class="value" id="val-exp-knife-spacing">600ms</span>
                            <div class="slider" id="sl-exp-knife-spacing" data-min="300" data-max="2000" data-decimals="0">
                                <div class="track"></div><div class="fill" id="fill-exp-knife-spacing"></div><div class="knob" id="knob-exp-knife-spacing"></div>
                            </div>
                        </div></div>
                    </div>
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">02</span><span>]</span><span>Grenade</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Key</span><div class="ctrl">
                            <div class="combo keybind" id="kb-exp-nade">
                                <span class="text" id="kb-exp-nade-text">Unbound</span>
                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="kb-exp-nade-popup">
                                    <div class="combo-item" id="kb-exp-nade-off">Off</div>
                                    <div class="combo-item" id="kb-exp-nade-always">Always</div>
                                    <div class="combo-item" id="kb-exp-nade-hold">Hold</div>
                                    <div class="combo-item" id="kb-exp-nade-toggle">Toggle</div>
                                    <div class="combo-item" id="kb-exp-nade-unset">Unset</div>
                                </div>
                            </div>
                        </div></div>
                        <div class="row"><span class="label">Trigger</span><div class="ctrl"><div class="btn btn-primary" id="btn-exp-nade">GRENADE</div></div></div>
                        <div class="row"><span class="label">At crosshair</span><div class="ctrl"><div class="checkbox" id="cb-exp-nade-crosshair"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Spacing</span><div class="ctrl"><span class="value" id="val-exp-nade-spacing">1100ms</span>
                            <div class="slider" id="sl-exp-nade-spacing" data-min="600" data-max="3000" data-decimals="0">
                                <div class="track"></div><div class="fill" id="fill-exp-nade-spacing"></div><div class="knob" id="knob-exp-nade-spacing"></div>
                            </div>
                        </div></div>
                    </div>
                </section>

                <!-- ==================== EXPLOITS / PACKETS ================== -->
                <section class="panel" id="panel-exp-packets">
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Position packet</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Always scoped</span><div class="ctrl"><div class="checkbox" id="cb-pkt-scope"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Always crouched</span><div class="ctrl"><div class="checkbox" id="cb-pkt-crouch"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Zero velocity</span><div class="ctrl"><div class="checkbox" id="cb-pkt-velocity"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Always on floor</span><div class="ctrl"><div class="checkbox" id="cb-pkt-onfloor"><span class="mark">&#10003;</span></div></div></div>
                    </div>
                </section>

            </div>
        </div>
    </div>
</div>
</body>
</rml>
