<rml>
<head>
    <style>
        /* ESP text layer: labels are created dynamically by the ESP module. */
        body
        {
            width: 100%;
            height: 100%;
            background: transparent;
            font-family: "JetBrains Mono";
        }

        #esp-layer
        {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
        }

        /* Two roots per player: one hugging the top of the player box for the
           name, one hugging the bottom for weapon/health/distance. */
        .esp-label
        {
            position: absolute;
            width: 280dp;
            text-align: center;
            display: block;
            white-space: nowrap;
            font-size: 15dp;
        }
        .esp-label.hidden
        {
            display: none;
        }
        .esp-label .name
        {
            display: inline-block;
            padding: 1dp 7dp;
            border-radius: 3dp;
            background: #0b0b0bd9;
            font-size: 1em;
            font-weight: bold;
            letter-spacing: 0.05em;
            color: #ff6b6b;
        }
        .esp-label.occluded .name
        {
            color: #a86060;
        }
        .esp-label.team .name
        {
            color: #6cb2ff;
        }
        .esp-label.occluded.team .name
        {
            color: #6a8bb0;
        }
        .esp-label .meta
        {
            display: inline-block;
            padding: 1dp 6dp;
            border-radius: 3dp;
            background: #0b0b0bb0;
            font-size: 0.85em;
            letter-spacing: 0.04em;
            color: #d2d2d2;
        }
        .esp-label.occluded .meta
        {
            color: #909090;
        }
    </style>
</head>

<body>
<div id="esp-layer"></div>
</body>
</rml>
