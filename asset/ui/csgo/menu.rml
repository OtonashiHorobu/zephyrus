                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Players</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Enabled</span><div class="ctrl"><div class="checkbox" id="cb-esp-enabled"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Box</span><div class="ctrl"><div class="checkbox" id="cb-esp-box"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Name</span><div class="ctrl"><div class="checkbox" id="cb-esp-name"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Health bar</span><div class="ctrl"><div class="checkbox" id="cb-esp-health"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Weapon</span><div class="ctrl"><div class="checkbox" id="cb-esp-weapon"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Distance</span><div class="ctrl"><div class="checkbox" id="cb-esp-distance"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Snaplines</span><div class="ctrl"><div class="checkbox" id="cb-esp-snapline"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Visible only</span><div class="ctrl"><div class="checkbox" id="cb-esp-visible"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Teammates</span><div class="ctrl"><div class="checkbox" id="cb-esp-team"><span class="mark">&#10003;</span></div></div></div>
                    </div>
                </section>

                <!-- ===================== VISUALS / GLOW ===================== -->
                <section class="panel" id="panel-visuals-glow">
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Glow</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Enabled</span><div class="ctrl"><div class="checkbox" id="cb-glow-enabled"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Style</span><div class="ctrl">
                            <div class="combo" id="co-glow-style">
                                <span class="text" id="co-glow-style-text">Default</span>
                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="co-glow-style-popup">
                                    <div class="combo-item selected" id="co-glow-style-0">Default</div>
                                    <div class="combo-item" id="co-glow-style-1">Rim3d</div>
                                    <div class="combo-item" id="co-glow-style-2">Edge</div>
                                    <div class="combo-item" id="co-glow-style-3">Edge Pulse</div>
                                </div>
                            </div>
                        </div></div>
                        <div class="row"><span class="label">Health based</span><div class="ctrl"><div class="checkbox" id="cb-glow-health"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Rainbow</span><div class="ctrl"><div class="checkbox" id="cb-glow-rainbow"><span class="mark">&#10003;</span></div></div></div>
                    </div>
                </section>

                <!-- ====================== MISC / MAIN ======================= -->
                <section class="panel" id="panel-misc-main">
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Interface</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Menu key</span><div class="ctrl">
                            <div class="combo keybind" id="kb-menu">
                                <span class="text" id="kb-menu-text">INSERT</span>
                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="kb-menu-popup">
                                    <div class="combo-item" id="kb-menu-off">Off</div>
                                    <div class="combo-item" id="kb-menu-always">Always</div>
                                    <div class="combo-item" id="kb-menu-hold">Hold</div>
                                    <div class="combo-item" id="kb-menu-toggle">Toggle</div>
                                    <div class="combo-item" id="kb-menu-unset">Unset</div>
                                </div>
                            </div>
                        </div></div>
                        <div class="row"><span class="label">Panic key</span><div class="ctrl">
                            <div class="combo keybind" id="kb-panic">
                                <span class="text" id="kb-panic-text">Unbound</span>
                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="kb-panic-popup">
                                    <div class="combo-item" id="kb-panic-off">Off</div>
                                    <div class="combo-item" id="kb-panic-always">Always</div>
                                    <div class="combo-item" id="kb-panic-hold">Hold</div>
                                    <div class="combo-item" id="kb-panic-toggle">Toggle</div>
                                    <div class="combo-item" id="kb-panic-unset">Unset</div>
                                </div>
                            </div>
                        </div></div>
                    </div>
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">02</span><span>]</span><span>Build</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Version</span><div class="ctrl"><span class="value" id="val-build-version">--</span></div></div>
                        <div class="row"><span class="label">Game</span><div class="ctrl"><span class="value" id="val-build-game">CS:GO 1.38.8.1</span></div></div>
                    </div>
                </section>

                <!-- ==================== MISC / MOVEMENT ==================== -->
                <section class="panel" id="panel-misc-movement">
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Movement</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Bunny hop</span><div class="ctrl"><div class="checkbox" id="cb-mv-bhop"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Auto strafe</span><div class="ctrl"><div class="checkbox" id="cb-mv-autostrafe"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Slow walk</span><div class="ctrl">
                            <div class="combo keybind" id="kb-mv-slowwalk">
                                <span class="text" id="kb-mv-slowwalk-text">Unbound</span>
                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="kb-mv-slowwalk-popup">
                                    <div class="combo-item" id="kb-mv-slowwalk-off">Off</div>
                                    <div class="combo-item" id="kb-mv-slowwalk-always">Always</div>
                                    <div class="combo-item" id="kb-mv-slowwalk-hold">Hold</div>
                                    <div class="combo-item" id="kb-mv-slowwalk-toggle">Toggle</div>
                                    <div class="combo-item" id="kb-mv-slowwalk-unset">Unset</div>
                                </div>
                            </div>
                        </div></div>
                    </div>
                </section>

                <!-- ======================== CONFIG ========================== -->
                <section class="panel" id="panel-config-main">
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Configuration</span><span class="rule"></span></div>
                        <div class="config-card">
                            <div class="config-col config-col-left">
                                <div class="config-heading">PROFILES</div>
                                <div class="config-list" id="config-list"></div>
                                <div class="config-heading">CONFIG NAME</div>
                                <input class="field config-name" id="in-config-name" type="text" value="default" size="16"/>
                            </div>
                            <div class="config-col config-col-right">
                                <div class="config-heading">ACTIONS</div>
                                <div class="btn btn-primary config-btn" id="btn-config-save">CREATE / SAVE</div>
                                <div class="btn config-btn" id="btn-config-load">LOAD SELECTED</div>
                                <div class="btn config-btn" id="btn-config-delete">DELETE SELECTED</div>
                                <div class="btn config-btn" id="btn-config-reset">RESET DEFAULTS</div>
                                <div class="btn config-btn" id="btn-config-folder">OPEN CONFIG FOLDER</div>
                                <div class="config-btn-row">
                                    <div class="btn config-btn" id="btn-config-export">EXPORT</div>
                                    <div class="btn config-btn" id="btn-config-import">IMPORT</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </div>
    </div>
</div>
</body>
</rml>
