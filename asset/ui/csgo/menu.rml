<rml>
<head>
    <style>
        /* ------------------------------------------------------------------
           zephyrus overlay menu
           Layout follows Osiris (top tabs + sidebar + two column sections),
           the visual language follows Analyst (near-black neutrals, single
           blue accent, hairlines, monospace, restrained motion).
           ------------------------------------------------------------------ */

        body
        {
            width: 100%;
            height: 100%;
            font-family: "JetBrains Mono";
            font-size: 13dp;
            color: #e8e8e8;
            background: transparent;
        }

        #menu
        {
            display: flex;
            flex-direction: column;
            position: absolute;
            /* Positioned from code (menu::materialize_position). Do not use
               percentage + negative margin centering here: RmlUi resolves the
               percentage against the element's own size when the size changes
               and keeps applying the margin to the children's containing
               block, which offsets every child by half the resize delta. */
            left: 0dp;
            top: 0dp;
            width: 900dp;
            height: 620dp;
            background: #131313;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 6dp;
            /* A tight contact shadow plus a soft ambient one. */
            box-shadow: 0dp 6dp 18dp 1dp #000000b8, 0dp 16dp 40dp 2dp #00000080;
            overflow: hidden;
        }
        #resize-handle
        {
            position: absolute;
            right: 0;
            bottom: 0;
            width: 20dp;
            height: 20dp;
            z-index: 80;
            cursor: pointer;
        }
        #resize-handle .grip
        {
            position: absolute;
            right: 3dp;
            bottom: 2dp;
            color: #5c5c5c;
            font-size: 12dp;
            transition: color 0.15s cubic-out;
        }
        #resize-handle:hover .grip
        {
            color: #3c9dff;
        }

        /* ---------------------------- header ---------------------------- */

        #menu-header
        {
            display: flex;
            align-items: center;
            height: 52dp;
            padding-left: 18dp;
            padding-right: 18dp;
            gap: 18dp;
            background: #161616;
            border-bottom-width: 1dp;
            border-bottom-color: #262626;
        }

        #wordmark
        {
            font-size: 16dp;
            font-weight: bold;
            letter-spacing: 0.08em;
            color: #e8e8e8;
            white-space: nowrap;
        }
        #wordmark .mark
        {
            color: #3c9dff;
        }
        #caret
        {
            display: inline-block;
            width: 8dp;
            height: 14dp;
            margin-left: 3dp;
            vertical-align: -2dp;
            background: #3c9dff;
            animation: blink 0.55s alternate infinite;
        }
        @keyframes blink
        {
            from { opacity: 1; }
            to { opacity: 0.15; }
        }
        @keyframes section-in
        {
            from { opacity: 0; transform: translateY(8dp); }
            to { opacity: 1; transform: translateY(0dp); }
        }
        @keyframes pop-in
        {
            from { opacity: 0; transform: translateY(4dp) scale(0.98); }
            to { opacity: 1; transform: translateY(0dp) scale(1); }
        }
        @keyframes pop-icon
        {
            0% { transform: scale(0.4); }
            70% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        #tabs
        {
            display: flex;
            align-items: center;
            gap: 4dp;
            flex: 1;
            height: 100%;
        }
        .tab
        {
            display: flex;
            align-items: center;
            height: 100%;
            padding-left: 14dp;
            padding-right: 14dp;
            color: #5c5c5c;
            font-size: 13dp;
            letter-spacing: 0.14em;
            border-bottom-width: 2dp;
            border-bottom-color: transparent;
            transition: color 0.15s cubic-out;
        }
        .tab:hover
        {
            color: #e8e8e8;
        }
        .tab.active
        {
            color: #e8e8e8;
            border-bottom-color: #3c9dff;
        }

        #header-meta
        {
            display: flex;
            align-items: center;
            gap: 10dp;
        }
        .badge
        {
            display: inline-block;
            padding: 3dp 10dp;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 4dp;
            font-size: 12dp;
            letter-spacing: 0.08em;
            color: #9a9a9a;
        }
        .badge-primary
        {
            border-color: #3c9dff74;
            color: #3c9dff;
        }
        #fps-label
        {
            color: #5c5c5c;
            font-size: 12dp;
            letter-spacing: 0.08em;
        }

        /* ----------------------------- body ----------------------------- */

        #menu-main
        {
            display: flex;
            flex: 1;
            min-height: 0;
        }

        #sidebar
        {
            display: flex;
            flex-direction: column;
            align-self: stretch;
            /* RmlUi does not always stretch a flex item to the cross size of
               its parent (#menu-main); without an explicit height the
               background stops at the last nav item and breaks off mid-menu. */
            height: 100%;
            min-height: 100%;
            flex-shrink: 0;
            gap: 4dp;
            width: 168dp;
            padding: 12dp 8dp;
            background: #161616;
            border-right-width: 1dp;
            border-right-color: #262626;
            position: relative;
            box-sizing: border-box;
        }
        #glider
        {
            position: absolute;
            left: 8dp;
            width: 152dp;
            height: 34dp;
            top: 12dp;
            background: #2222228c;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 5dp;
            transition: top 0.42s quintic-out, height 0.42s quintic-out;
            z-index: 0;
        }
        .nav-item
        {
            display: flex;
            align-items: center;
            height: 34dp;
            padding-left: 12dp;
            gap: 10dp;
            color: #9a9a9a;
            font-size: 13.5dp;
            letter-spacing: 0.04em;
            border-radius: 5dp;
            transition: color 0.15s cubic-out, background 0.15s cubic-out;
            z-index: 1;
        }
        .nav-item .glyph
        {
            color: #5c5c5c;
            font-size: 10dp;
            width: 10dp;
            transition: color 0.15s cubic-out, transform 0.18s cubic-out;
        }
        .nav-item:hover
        {
            color: #e8e8e8;
            background: #1b1b1b;
        }
        .nav-item.active
        {
            color: #e8e8e8;
            background: transparent;
        }
        .nav-item.active .glyph
        {
            color: #3c9dff;
            transform: scale(1.25);
        }
        .nav-item.hidden
        {
            display: none;
        }

        #content
        {
            flex: 1;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            padding: 18dp 24dp;
        }
        #content-scroll
        {
            position: relative;
            /* Block (not flex column): every extra flex level multiplies
               RmlUi's shrink-to-fit measurement work during a relayout
               (measured: each nesting level roughly halved the 60ms spike). */
            width: 100%;
        }

        /* --------------------------- sections --------------------------- */

        .section
        {
            display: block;
            margin-bottom: 22dp;
        }
        .section-title
        {
            display: flex;
            align-items: center;
            gap: 8dp;
            margin-bottom: 12dp;
            padding-left: 12dp;
            padding-right: 12dp;
            font-size: 12.5dp;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #5c5c5c;
        }
        .section-title .idx
        {
            color: #3c9dff;
            font-weight: bold;
        }
        .section-title .rule
        {
            flex: 1;
            height: 1dp;
            margin-left: 4dp;
            background: #262626;
        }

        .row
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            min-height: 36dp;
            padding-left: 12dp;
            padding-right: 12dp;
            border-radius: 5dp;
            transition: background 0.15s cubic-out;
        }
        .row:hover
        {
            background: #1b1b1b;
        }
        .label
        {
            color: #9a9a9a;
            font-size: 14dp;
            letter-spacing: 0.04em;
            flex-shrink: 1;
            min-width: 0;
            transition: color 0.15s cubic-out;
        }
        .row:hover .label
        {
            color: #e8e8e8;
        }
        .ctrl
        {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            /* Basis 0: the parent flex line must not measure the control's
               max-content (that is what recursed into nested flex). */
            flex: 1;
            min-width: 0;
            gap: 14dp;
        }
        .value
        {
            color: #9a9a9a;
            font-size: 13dp;
            text-align: right;
            min-width: 44dp;
        }
        .hint
        {
            color: #5c5c5c;
            font-size: 12.5dp;
            padding-left: 12dp;
            padding-right: 12dp;
            line-height: 1.7;
        }
        .key
        {
            display: inline-block;
            padding: 4dp 10dp;
            background: #1b1b1b;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 4dp;
            color: #e8e8e8;
            font-size: 12.5dp;
            letter-spacing: 0.08em;
        }

        /* -------------------------- controls ---------------------------- */

        .checkbox
        {
            position: relative;
            width: 18dp;
            height: 18dp;
            background: #1b1b1b;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 4dp;
            transition: background 0.15s cubic-out, border-color 0.15s cubic-out;
            cursor: pointer;
        }
        .checkbox:hover
        {
            border-color: #3c9dff;
        }
        .checkbox .mark
        {
            display: block;
            text-align: center;
            font-size: 14dp;
            line-height: 18dp;
            color: #0b1220;
            opacity: 0;
            transition: opacity 0.15s cubic-out;
        }
        .checkbox.checked
        {
            background: #3c9dff;
            border-color: #3c9dff;
        }
        .checkbox.checked .mark
        {
            opacity: 1;
            animation: pop-icon 0.25s quintic-out;
        }

        .slider
        {
            position: relative;
            /* Flexible so the control column adapts to the panel width. */
            flex: 1;
            min-width: 100dp;
            max-width: 190dp;
            height: 18dp;
            cursor: pointer;
        }
        .slider .track
        {
            position: absolute;
            left: 0;
            right: 0;
            top: 6dp;
            height: 6dp;
            background: #222222;
            border-radius: 2dp;
        }
        .slider .fill
        {
            position: absolute;
            left: 0;
            top: 6dp;
            height: 6dp;
            width: 0%;
            background: #3c9dff;
            border-radius: 2dp;
            transition: width 0.15s cubic-out;
        }
        .slider .knob
        {
            position: absolute;
            left: 0%;
            top: 0;
            width: 16dp;
            height: 18dp;
            margin-left: -8dp;
            background: #e8e8e8;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 4dp;
            transition: left 0.15s cubic-out, background 0.15s cubic-out, border-color 0.15s cubic-out;
        }
        .slider.dragging .fill,
        .slider.dragging .knob
        {
            transition: none;
        }
        .slider:hover .knob
        {
            background: #3c9dff;
            border-color: #3c9dff;
        }

        .combo
        {
            position: relative;
            /* Block + floated caret: one less flex level (each nesting level
               roughly halves RmlUi's relayout work, measured). */
            display: block;
            min-width: 130dp;
            padding: 6dp 11dp;
            background: #1b1b1b;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 5dp;
            transition: border-color 0.15s cubic-out;
            cursor: pointer;
        }
        .combo:hover
        {
            border-color: #3c9dff;
        }
        .combo .text
        {
            color: #e8e8e8;
            font-size: 13.5dp;
            letter-spacing: 0.04em;
        }
        .combo .caret
        {
            float: right;
            color: #5c5c5c;
            font-size: 13dp;
            line-height: 13dp;
        }
        .combo-popup
        {
            position: absolute;
            left: 0;
            top: 100%;
            width: 100%;
            margin-top: 4dp;
            padding: 3dp;
            display: none;
            background: #1b1b1b;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 5dp;
            z-index: 50;
        }
        .combo-popup.open
        {
            display: block;
            animation: pop-in 0.16s quintic-out;
        }
        .combo-item
        {
            display: block;
            padding: 4dp 8dp;
            border-radius: 3dp;
            color: #9a9a9a;
            font-size: 12.5dp;
            letter-spacing: 0.04em;
            white-space: nowrap;
            transition: background 0.12s cubic-out, color 0.12s cubic-out;
        }
        .combo-item:hover
        {
            background: #222222;
            color: #e8e8e8;
        }
        .combo-item.selected
        {
            color: #3c9dff;
        }

        .btn
        {
            display: inline-block;
            padding: 5dp 12dp;
            background: transparent;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 5dp;
            color: #9a9a9a;
            font-size: 12dp;
            letter-spacing: 0.06em;
            transition: background 0.15s cubic-out, color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.15s cubic-out;
            cursor: pointer;
        }
        .btn:hover
        {
            background: #1b1b1b;
            color: #e8e8e8;
        }
        .btn:active
        {
            background: #222222;
            transform: scale(0.97);
        }
        .btn-primary
        {
            background: #3c9dff;
            border-color: #3c9dff;
            color: #0b1220;
            font-weight: bold;
        }
        .btn-primary:hover
        {
            background: #59acff;
            border-color: #59acff;
            color: #0b1220;
        }

        /* Config name field (Osiris/OAE style). */
        input.field, .field
        {
            width: 170dp;
            height: 24dp;
            padding-left: 8dp;
            padding-right: 8dp;
            background: #101010;
            border-width: 1dp;
            border-color: #333333;
            border-radius: 5dp;
            color: #e8e8e8;
            font-size: 12dp;
            caret-color: #3c9dff;
        }
        input.field:hover, .field:hover
        {
            border-color: #3c9dff;
        }

        /* Config tab: a bordered card with two columns (OsirisAndExtra). */
        .config-card
        {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            gap: 24dp;
            margin: 0dp 12dp;
            padding: 12dp;
            background: #131313;
            border-width: 1dp;
            border-color: #262626;
            border-radius: 6dp;
        }
        .config-col
        {
            display: flex;
            flex-direction: column;
            gap: 8dp;
        }
        .config-col-left
        {
            flex: 1;
        }
        .config-col-right
        {
            width: 220dp;
            flex-shrink: 0;
        }
        .config-heading
        {
            color: #5c5c5c;
            font-size: 11dp;
            letter-spacing: 0.1em;
        }
        input.config-name
        {
            width: auto;
            height: 24dp;
            padding: 0dp 8dp;
            line-height: 24dp;
        }
        .config-btn
        {
            width: 100%;
            height: 26dp;
            padding: 0dp;
            line-height: 26dp;
            text-align: center;
        }
        .config-btn-row
        {
            display: flex;
            flex-direction: row;
            gap: 8dp;
        }
        .config-btn-row .config-btn
        {
            width: auto;
            flex: 1;
        }
        .config-list
        {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 116dp;
            overflow: hidden;
            background: #0e0e0e;
            border-width: 1dp;
            border-color: #2e2e2e;
            border-radius: 5dp;
            padding: 3dp;
        }
        .config-item
        {
            flex-shrink: 0;
            height: 24dp;
            line-height: 24dp;
            padding: 0dp 8dp;
            color: #9a9a9a;
            font-size: 12dp;
        }
        .config-item:hover
        {
            background: #1b1b1b;
            color: #e8e8e8;
        }
        .config-item.selected
        {
            background: #22354a;
            color: #e8e8e8;
        }

        /* --------------------------- panels ----------------------------- */

        .panel
        {
            display: none;
            flex-direction: column;
        }
        .panel.active
        {
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            width: 100%;
            animation: panel-in 0.32s quintic-out both;
        }
        @keyframes panel-in
        {
            from { opacity: 0; transform: translateY(6dp); }
            to { opacity: 1; transform: translateY(0dp); }
        }

        /* --------------------------- footer ----------------------------- */

        #menu-footer
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 28dp;
            padding-left: 14dp;
            padding-right: 14dp;
            background: #161616;
            border-top-width: 1dp;
            border-top-color: #262626;
        }
        #footer-hint
        {
            color: #5c5c5c;
            font-size: 11dp;
            letter-spacing: 0.06em;
        }
        #footer-brand
        {
            color: #3c9dff;
            font-size: 11dp;
            letter-spacing: 0.06em;
        }
        /* ---- ESP overlay (always-on layer, independent of #menu) ---- */
        #esp-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
        .esp-box { position: absolute; border-width: 1dp; border-color: rgb(235,235,235); }
        .esp-box.team { border-color: rgb(130,180,255); }
        .esp-box.enemy { border-color: rgb(240,110,110); }
        .esp-box.visible { border-color: rgb(120,240,140); }
        .esp-health-bg { position: absolute; width: 3dp; background-color: rgba(0,0,0,170); }
        .esp-health-fill { position: absolute; left: 0; bottom: 0; width: 100%; background-color: rgb(120,240,140); }
        .esp-label { position: absolute; font-size: 12dp; color: rgb(240,240,240); white-space: nowrap; }
        .esp-distance { color: rgb(200,200,200); }
        .esp-weapon { color: rgb(210,190,120); }
        .esp-snapline { position: absolute; height: 1dp; background-color: rgba(240,240,240,150); transform-origin: left center; }
    </style>
</head>
<body>
<div id="esp-layer"></div>
<div id="menu">
    <div id="menu-header">
        <div id="wordmark">[<span class="mark">zephyrus</span><span id="caret"></span>]</div>
        <div id="tabs">
            <div class="tab active" id="tab-rage"><span>RAGEBOT</span></div>
            <div class="tab" id="tab-visuals"><span>VISUALS</span></div>
            <div class="tab" id="tab-misc"><span>MISC</span></div>
            <div class="tab" id="tab-config"><span>CONFIGS</span></div>
        </div>
        <div id="header-meta">
            <span id="fps-label">-- FPS</span>
        </div>
    </div>
    <div id="resize-handle"><span class="grip">&#8599;</span></div>

    <div id="menu-main">
        <div id="sidebar">
            <div id="glider"></div>
            <div class="nav-item active group-rage" id="nav-rage-main"><span class="glyph">&#9679;</span><span>Main</span></div>
            <div class="nav-item group-rage" id="nav-rage-backtrack"><span class="glyph">&#9679;</span><span>Backtrack</span></div>
            <div class="nav-item group-rage" id="nav-rage-antiaim"><span class="glyph">&#9679;</span><span>AntiAim</span></div>
            <div class="nav-item group-rage" id="nav-rage-fakelag"><span class="glyph">&#9679;</span><span>FakeLag</span></div>
            <div class="nav-item group-rage" id="nav-rage-resolver"><span class="glyph">&#9679;</span><span>Resolver</span></div>
            <div class="nav-item group-rage" id="nav-rage-weapons"><span class="glyph">&#9679;</span><span>Weapons</span></div>
            <div class="nav-item active group-visuals" id="nav-visuals-main"><span class="glyph">&#9679;</span><span>Main</span></div>
            <div class="nav-item group-visuals" id="nav-visuals-esp"><span class="glyph">&#9679;</span><span>Esp</span></div>
            <div class="nav-item group-visuals" id="nav-visuals-glow"><span class="glyph">&#9679;</span><span>Glow</span></div>
            <div class="nav-item active group-misc" id="nav-misc-main"><span class="glyph">&#9679;</span><span>Main</span></div>
            <div class="nav-item group-misc" id="nav-misc-movement"><span class="glyph">&#9679;</span><span>Movement</span></div>
            <div class="nav-item active group-config" id="nav-config-main"><span class="glyph">&#9679;</span><span>Profiles</span></div>
        </div>

        <div id="content">
            <div id="content-scroll">

                <!-- ======================= RAGE / MAIN ======================= -->
                <section class="panel active" id="panel-rage-main">
                    <div class="section">
                        <div class="section-title"><span>[</span><span class="idx">01</span><span>]</span><span>Aimbot</span><span class="rule"></span></div>
                        <div class="row"><span class="label">Enabled</span><div class="ctrl"><div class="checkbox" id="cb-rage-enabled"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Key</span><div class="ctrl">
                            <div class="combo keybind" id="kb-rage">
                                <span class="text" id="kb-rage-text">On</span>
                                <span class="caret">&#9660;</span>
                                <div class="combo-popup" id="kb-rage-popup">
                                    <div class="combo-item" id="kb-rage-off">Off</div>
                                    <div class="combo-item" id="kb-rage-always">Always</div>
                                    <div class="combo-item" id="kb-rage-hold">Hold</div>
                                    <div class="combo-item" id="kb-rage-toggle">Toggle</div>
                                    <div class="combo-item" id="kb-rage-unset">Unset</div>
                                </div>
                            </div>
                        </div></div>
                        <div class="row"><span class="label">Silent aim</span><div class="ctrl"><div class="checkbox" id="cb-rage-silent"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Auto fire</span><div class="ctrl"><div class="checkbox" id="cb-rage-autofire"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Auto scope</span><div class="ctrl"><div class="checkbox" id="cb-rage-autoscope"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">Auto stop</span><div class="ctrl"><div class="checkbox" id="cb-rage-autostop"><span class="mark">&#10003;</span></div></div></div>
                        <div class="row"><span class="label">No recoil</span><div class="ctrl"><div class="checkbox" id="cb-rage-norecoil"><span class="mark">&#10003;</span></div></div></div>
                    </div>
                    <div class="section">
